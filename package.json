{
  "name": "azul-code",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first macOS dashboard for AI coding usage, subscription allowances, and GitHub contributions.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run typecheck && electron-vite build && npm run verify:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config vitest.config.ts run",
    "test:watch": "vitest --config vitest.config.ts",
    "test:menubar": "npm run build && env -u ELECTRON_RUN_AS_NODE electron scripts/smoke-menu-bar.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "lucide-react": "1.37.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.luis.azul-code",
    "productName": "azul-code",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/*.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "NOTICE",
      "licenses/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "azul-code ${version}",
      "backgroundColor": "#0c0d0f",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-velazquez/ai-codeing-stats.git"
  },
  "homepage": "https://github.com/l-velazquez/ai-codeing-stats#readme",
  "bugs": {
    "url": "https://github.com/l-velazquez/ai-codeing-stats/issues"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Luis Velazquez",
    "url": "https://github.com/l-velazquez"
  }
}
